# AnyWarehouse 前端 生产环境变量样例（仅 VITE_*，构建时注入，勿放敏感信息）
# 将此文件复制为 .env.production 并填写实际值，或在 CI 中以环境变量方式注入

# 统一同域反代到后端（推荐）
VITE_API_BASE_URL=/api

# 若图片 URL 需要绝对前缀，取消注释并设置为你的站点根（含 https）
# VITE_IMAGE_BASE_URL=https://yourdomain.com

VITE_APP_NAME=AnyWarehouse
VITE_DEBUG=false

# 可选功能开关
VITE_ENABLE_IMAGE_UPLOAD=true
VITE_ENABLE_NOTIFICATIONS=false
# 50MB
VITE_MAX_FILE_SIZE=52428800

# 警告：不要在前端 VITE_* 中放任何机密信息；这些会被打包到客户端。

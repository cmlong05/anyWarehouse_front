VITE_API_BASE_URL=http://your-api-server
VITE_IMAGE_BASE_URL=http://your-image-server
VITE_APP_NAME=AnyWarehouse
VITE_DEBUG=false


// 5. 高级配置管理
// src/lib/config/database.ts
export const dbConfig = {
  host: import.meta.env.VITE_DB_HOST || 'localhost',
  port: parseInt(import.meta.env.VITE_DB_PORT || '5432'),
  database: import.meta.env.VITE_DB_NAME || 'warehouse',
  // 注意：实际项目中数据库密码不应该暴露给前端
};

// src/lib/config/features.ts  
export const features = {
  enableImageUpload: import.meta.env.VITE_ENABLE_IMAGE_UPLOAD === 'true',
  enableNotifications: import.meta.env.VITE_ENABLE_NOTIFICATIONS === 'true',
  maxFileSize: parseInt(import.meta.env.VITE_MAX_FILE_SIZE || '5242880'), // 5MB
};

// 6. 配置验证和类型安全
// src/lib/config/validator.ts
import { z } from 'zod';

const configSchema = z.object({
  API_BASE_URL: z.string().url('API_BASE_URL must be a valid URL'),
  IMAGE_BASE_URL: z.string().url('IMAGE_BASE_URL must be a valid URL'),
  APP_NAME: z.string().min(1, 'APP_NAME cannot be empty'),
  DEBUG: z.boolean(),
  NODE_ENV: z.enum(['development', 'production', 'test'])
});

export function validateConfig(config: unknown) {
  const result = configSchema.safeParse(config);
  
  if (!result.success) {
    console.error('配置验证失败:', result.error.format());
    throw new Error('Invalid configuration');
  }
  
  return result.data;
}
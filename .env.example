# AnyWarehouse 前端环境配置
# 复制此文件为 .env 并填入实际值

# 必需配置
VITE_API_BASE_URL=http://localhost:8000

# 可选配置
VITE_IMAGE_BASE_URL=http://your-image-server
VITE_APP_NAME=AnyWarehouse
VITE_DEBUG=false

# 功能开关
VITE_ENABLE_IMAGE_UPLOAD=false
VITE_ENABLE_NOTIFICATIONS=false
VITE_MAX_FILE_SIZE=5242880

# 数据库配置（如果前端需要）
# 注意：生产环境中不应在前端暴露数据库配置
VITE_DB_HOST=localhost
VITE_DB_PORT=5432
VITE_DB_NAME=warehouse
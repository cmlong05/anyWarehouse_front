{
	"name": "anywarehouse-front",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun x vite dev",
		"build": "NODE_ENV=production bun x svelte-kit sync && NODE_ENV=production bun x vite build",
		"preview": "bun x vite preview",
		"start": "bun ./build/index.js",
		"prepare": "bun x svelte-kit sync || echo ''",
		"check": "bun x svelte-kit sync && bun x svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bun x svelte-kit sync && bun x svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.3.2",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/forms": "^0.5.9",
		"@tailwindcss/typography": "^0.5.15",
		"@tailwindcss/vite": "^4.0.0",
		"autoprefixer": "^10.4.21",
		"postcss": "^8.5.6",
		"svelte": "^5.36.8",
		"svelte-check": "^4.0.0",
		"sveltekit-superforms": "^2.27.1",
		"tailwindcss": "^4.1.11",
		"typescript": "^5.0.0",
		"vite": "^6.2.6",
		"zod": "^4.0.5"
	},
	"packageManager": "bun@1.1.22",
	"engines": {
		"bun": ">=1.1.0"
	},
	"dependencies": {
		"html2pdf.js": "^0.14.0",
		"lucide-svelte": "^0.577.0",
		"svelecte": "^5.2.0"
	}
}
